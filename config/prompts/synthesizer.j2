{#
  synthesizer.j2 — Synthesizer agent prompt (Flow C user-facing voice).

  Variables injected:
    coach_response_text      str     Coach's response text.
    coach_referenced_facts   list    Fact keys the Coach cited.
    da_output                dict    DA output: counter_points, blind_spots, risks,
                                     agrees_with_coach.
    research_findings        list    Findings from ResearchBrief (may be empty).
                                     Each: { claim, confidence, is_numeric, citations }
    research_caveats         list    Caveats from ResearchBrief.
    user_facts               dict    Structured user facts.
    active_hypotheses        list    Current hypotheses about the user.
    intent_specific_ask      str     The user's specific question.
    has_research             bool    True if research_findings is non-empty.
    critic_feedback          str     Populated on retry — previous Critic complaints.
    current_date             str     ISO date string.

  Output contract:
    JSON object matching SynthesizedResponse:
    {
      "response_text": "... [1] ... [2] ...",
      "referenced_facts": ["age", "degree"],
      "referenced_hypotheses": ["uuid-string"],
      "referenced_findings": ["finding claim string"],
      "citations": [
        { "url": "https://...", "kb_path": null, "title": "...", "source_type": "web" },
        { "url": null, "kb_path": "kb/careers/...", "title": "...", "source_type": "kb" }
      ],
      "surfaced_tradeoffs": ["tradeoff statement"],
      "integrated_from": ["coach", "devils_advocate", "researcher"],
