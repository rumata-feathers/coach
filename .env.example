# ---- LLM providers ----
ANTHROPIC_API_KEY=
HUGGINGFACE_API_TOKEN=

# ---- Supabase / Postgres ----
# For v0 you can point at local docker-compose Postgres instead of Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=postgresql://coach:coach@localhost:5432/coach

# ---- Embeddings ----
# Using Hugging Face Inference API with sentence-transformers/all-MiniLM-L6-v2 (384 dims).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- LLM provider default ----
LLM_PROVIDER_DEFAULT=huggingface

# ---- Runtime ----
LOG_LEVEL=INFO
